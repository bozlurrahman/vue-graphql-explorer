{
  "name": "vue-graphql-explorer",
  "version": "0.0.0",
  "description": "GraphiQL-style GraphQL explorer component for Vue 2.7 and Vue 3",
  "license": "MIT",
  "author": "Bozlur Rahman",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bozlurrahman/vue-graphql-explorer.git"
  },
  "bugs": "https://github.com/bozlurrahman/vue-graphql-explorer/issues",
  "homepage": "https://github.com/bozlurrahman/vue-graphql-explorer#readme",
  "keywords": [
    "vue",
    "vue2",
    "vue3",
    "graphql",
    "graphiql",
    "explorer",
    "component"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "scripts/switch.mjs",
    "scripts/postinstall.mjs"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vue3": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/vue3/index.js"
    },
    "./vue2": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/vue2/index.js"
    },
    "./style.css": "./dist/style.css",
    "./vue3/style.css": "./dist/vue3/style.css",
    "./vue2/style.css": "./dist/vue2/style.css",
    "./package.json": "./package.json"
  },
  "bin": {
    "vue-graphql-explorer-switch": "./scripts/switch.mjs"
  },
  "scripts": {
    "setup": "npm install && npm install --prefix toolchain/vue2",
    "postinstall": "node ./scripts/postinstall.mjs",
    "build": "npm run build:vue3 && npm run build:vue2 && npm run build:types && node ./scripts/switch.mjs 3",
    "build:vue3": "vite build --mode vue3",
    "build:vue2": "vite build --mode vue2",
    "build:types": "vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write --ignore-path .gitignore .",
    "test": "vitest run",
    "pack:check": "npm pack --dry-run",
    "test:ssr:vue2": "node ./scripts/ssr-check-vue2.mjs",
    "test:vue2": "vitest run --config toolchain/vue2/vitest.config.mjs",
    "size": "node ./scripts/size-report.mjs"
  },
  "peerDependencies": {
    "graphql": "^16.0.0",
    "vue": "^2.7.0 || ^3.3.0"
  },
  "dependencies": {
    "copy-to-clipboard": "^4.0.2",
    "graphql-language-service": "^5.5.1",
    "graphql-ws": "^6.0.8",
    "meros": "^1.3.2",
    "subscriptions-transport-ws": "^0.11.0",
    "vue-demi": "^0.14.10"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "graphql": "^16.14.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.8.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.3.8",
    "vitest": "~4.0.0",
    "vue": "^3.5.34",
    "vue-tsc": "^3.3.14"
  }
}
